# Canonical origin (no trailing slash). Sitemap, robots, canonical URLs,
# JSON-LD and the prerender all derive from this. Copy the file to .env and
# set your real domain (e.g. https://izkor.example) before launching.
VITE_SITE_URL=

# Firebase configuration placeholders (Phase 5 wires the real values).
# Copy to .env.local and fill in from the Firebase console project settings.
# Without these, initFirebase() no-ops gracefully and the app runs fully local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

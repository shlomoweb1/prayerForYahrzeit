    "lightningcss-cli": "^1.33.0",
    "mdn-data": "^2.31.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "headless-datetimepicker": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
